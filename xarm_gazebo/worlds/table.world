<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://table</uri>
      <name>table</name>
      <pose>0.0 -0.34 0 0 0 0</pose>
    </include>

<model name="cube"> <!-- Cube model for testing -->
  <pose>-0.3 -0.3 1.045 0 0 0</pose>
  <link name="link">
    <inertial>
      <mass>0.2</mass>
    </inertial>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.05 0.05 0.05</size>
        </box>
      </geometry>
      <surface>
        <contact>
          <ode>
            <soft_cfm>0.001</soft_cfm>
            <soft_erp>0.8</soft_erp>
            <kp>1000</kp>
            <kd>100</kd>
            <max_vel>0.05</max_vel>
            <min_depth>0.001</min_depth>
          </ode>w
        </contact>
        <friction>
          <ode>
            <mu>50.0</mu>
            <mu2>50.0</mu2>
          </ode>
        </friction>
         <bounce>
          <restitution_coefficient>0.0</restitution_coefficient>
          <threshold>0.0</threshold>
        </bounce>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.05 0.05 0.05</size>
        </box>
      </geometry>
      <material>
        <ambient>0 1 0 1</ambient>
        <diffuse>0 1 0 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="sphere">
  <pose>-0.5 -0.5 1.045 0 0 0</pose>
  <link name="link">
    <inertial>
      <mass>0.2</mass>
    </inertial>
    <collision name="collision">
      <geometry>
        <sphere>
          <radius>0.05</radius>
        </sphere>
      </geometry>
      <!-- You can keep the rest of your contact/friction/bounce here -->
    </collision>
    <visual name="visual">
      <geometry>
        <sphere>
          <radius>0.05</radius>
        </sphere>
      </geometry>
      <material>
        <ambient>1 0 0 1</ambient>   <!-- Red ambient color -->
        <diffuse>1 0 0 1</diffuse>   <!-- Red diffuse color -->
      </material>
    </visual>
  </link>
</model>



<model name="aircraft_wing_sheet">
  <pose>0 0 2.5 0 0 0</pose>
  <static>true</static>
  <link name="wing_link">
    <!-- Wing main body -->
    <collision name="wing_collision">
      <geometry>
        <box>
          <size>2.5 1.0 0.05</size>
        </box>
      </geometry>
    </collision>
    <visual name="wing_visual">
      <geometry>
        <box>
          <size>2.5 1.0 0.05</size>
        </box>
      </geometry>
      <material>
        <ambient>0.7 0.7 0.7 1</ambient>
        <diffuse>0.8 0.8 0.8 1</diffuse>
      </material>
    </visual>

    <!-- Left blue square under the wing (x = -0.5) -->
    <visual name="blue_square_left">
      <pose>-0.5 0 -0.025 0 0 0</pose>
      <geometry>
        <box>
          <size>0.05 0.05 0.001</size>
        </box>
      </geometry>
      <material>
        <ambient>0 0 1 1</ambient>
        <diffuse>0 0 1 1</diffuse>
      </material>
    </visual>
    <!-- Right blue square under the wing (x = +0.5) -->
    <visual name="blue_square_right">
      <pose>0.3 0 -0.03 0 0 0</pose>
      <geometry>
        <box>
          <size>0.05 0.05 0.001</size>
        </box>
      </geometry>
      <material>
        <ambient>0 0 1 1</ambient>
        <diffuse>0 0 1 1</diffuse>
      </material>
    </visual>
  </link>
</model>




    <!-- Physics should be OUTSIDE the model, directly under <world> -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
    </physics>

  </world>
</sdf>
