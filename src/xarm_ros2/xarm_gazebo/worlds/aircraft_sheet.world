<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- FIX: Add the Gazebo ROS plugin that provides the /set_entity_state service -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10</update_rate>
    </plugin>

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <model name="aircraft_wing_sheet"> 
      <pose>0 0 0.85 0 0 0</pose>
      <static>true</static>
      <link name="wing_link">
        <collision name="wing_collision">
          <geometry>
            <box>
              <size>1.5 1.0 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="wing_visual">
          <geometry>
            <box>
              <size>1.5 1.0 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <!-- The blue square visual has been removed from here -->
      </link>
    </model>
    
    <!-- FIX: Create a separate, movable model for the blue square -->
    <model name="blue_square">
      <!-- Initial position matches the old visual's position -->
      <pose>0.40 0 0.82 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <kinematic>true</kinematic>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.03 0.03 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
        <!-- Add a collision shape so the depth camera can see it -->
        <collision name="collision">
           <geometry>
            <box>
              <size>0.03 0.03 0.001</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

   

